# Optional. Copy to .env; package scripts load it locally.
# CHAINS=8453
# PORT=4317
# RPC_8453=https://mainnet.base.org
# RPC_INTERVAL_MS=200
# GAUGECRAFT_DB=data/gaugecraft.sqlite
# COLLECT=0
# SAVE_FORECASTS=0

# Persistent hosting (see DEPLOYMENT.md; never commit real credentials)
# HOST=0.0.0.0
# ALLOWED_HOSTS=gaugecraft.example.com
# CORS_ORIGINS=https://provatidis.com
# REQUIRE_EXISTING_DB=1
# BACKUP_ENABLED=1
# BACKUP_TEMP_DIR=/tmp
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=gaugecraft-private
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# BOOTSTRAP_R2_BACKUP=backups/EXACT_VERIFIED_GENERATION
# VITE_API_ORIGIN=https://YOUR_VERIFIED_API_ORIGIN
